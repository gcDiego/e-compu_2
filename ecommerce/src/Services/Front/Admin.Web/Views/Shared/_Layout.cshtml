<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · E-Compu Admin</title><link rel="stylesheet" href="~/css/admin.css"/></head><body><aside class="sidebar"><a class="logo" asp-controller="Dashboard" asp-action="Index"><span>Admin</span></a><nav><a asp-controller="Dashboard" asp-action="Index">Resumen</a><a asp-controller="Catalog" asp-action="Products">Productos</a><a asp-controller="Catalog" asp-action="Categories">Categorías</a><a asp-controller="Catalog" asp-action="Brands">Marcas</a><a asp-controller="AdminUsers" asp-action="Index">Usuarios</a><a asp-controller="Orders" asp-action="Index">Pedidos</a><a asp-controller="Orders" asp-action="Report">Reportes</a></nav><div class="user">@Context.Session.GetString("AdminName")<form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Cerrar sesión</button></form></div></aside><main class="main">@if(TempData["Message"] is string message){<div class="notice success">@message</div>}@if(TempData["Error"] is string error){<div class="notice error">@error</div>}@RenderBody()</main></body></html>