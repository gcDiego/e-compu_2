@model IReadOnlyList<BrandModel>
@{ViewData["Title"]="Marcas";}<header><h1>Marcas</h1></header><section class="panel"><form asp-action="SaveBrand" method="post" class="inline-form"><input name="Description" maxlength="120" placeholder="Nueva marca" required/><input name="IsActive" type="hidden" value="true"/><button class="primary">Agregar</button></form><table><thead><tr><th>ID</th><th>Descripción</th><th>Estado</th><th>Editar</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Id</td><td>@x.Description</td><td>@(x.IsActive?"Activa":"Inactiva")</td><td><form asp-action="SaveBrand" method="post" class="inline-form"><input name="Id" type="hidden" value="@x.Id"/><input name="Description" value="@x.Description" maxlength="120" required/><select name="IsActive"><option value="true" selected="@x.IsActive">Activa</option><option value="false" selected="@(!x.IsActive)">Inactiva</option></select><button>Guardar</button></form></td></tr>}</tbody></table></section>