@model CatalogViewModel
@{ViewData["Title"]="Productos";}<header><h1>Productos</h1><p>Gestiona catálogo, precios, stock e imágenes</p></header><section class="panel"><details><summary class="primary">Nuevo producto</summary><form asp-action="SaveProduct" method="post" enctype="multipart/form-data" class="grid-form"><label>Nombre<input name="Name" maxlength="160" required/></label><label>Descripción<textarea name="Description" maxlength="2000" required></textarea></label><label>Marca<select name="BrandId" required>@foreach(var x in Model.Brands.Where(x=>x.IsActive)){<option value="@x.Id">@x.Description</option>}</select></label><label>Categoría<select name="CategoryId" required>@foreach(var x in Model.Categories.Where(x=>x.IsActive)){<option value="@x.Id">@x.Description</option>}</select></label><label>Precio<input name="Price" type="number" min="0.01" step="0.01" required/></label><label>Stock<input name="Stock" type="number" min="0" max="1000000" required/></label><label>Imagen<input name="Image" type="file" accept="image/jpeg,image/png,image/webp"/></label><input name="IsActive" type="hidden" value="true"/><button class="primary">Guardar</button></form></details></section><section class="product-grid">@foreach(var x in Model.Products){<article class="product-card">@if(x.ImageUrl is not null){<img src="@x.ImageUrl" alt=""/>}<div><h2>@x.Name</h2><span class="badge">@x.Category.Description · @x.Brand.Description</span><p>@x.Description</p><strong>@x.Price.ToString("C")</strong><p class="@(x.Stock<=3?"danger":"")">Stock: @x.Stock</p><small>@(x.IsActive?"Activo":"Inactivo")</small><details><summary>Editar</summary><form asp-action="SaveProduct" method="post" enctype="multipart/form-data" class="grid-form"><input name="Id" type="hidden" value="@x.Id"/><input name="Version" type="hidden" value="@x.Version"/><label>Nombre<input name="Name" value="@x.Name" required/></label><label>Descripción<textarea name="Description" required>@x.Description</textarea></label><label>Marca<select name="BrandId">@foreach(var b in Model.Brands){<option value="@b.Id" selected="@(b.Id==x.Brand.Id)">@b.Description</option>}</select></label><label>Categoría<select name="CategoryId">@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(c.Id==x.Category.Id)">@c.Description</option>}</select></label><label>Precio<input name="Price" type="number" step="0.01" min="0.01" value="@x.Price"/></label><label>Stock<input name="Stock" type="number" min="0" value="@x.Stock"/></label><label>Estado<select name="IsActive"><option value="true" selected="@x.IsActive">Activo</option><option value="false" selected="@(!x.IsActive)">Inactivo</option></select></label><label>Nueva imagen<input name="Image" type="file" accept="image/jpeg,image/png,image/webp"/></label><button>Guardar cambios</button></form></details></div></article>}</section>