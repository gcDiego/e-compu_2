@model IReadOnlyList<AdminProfile>
@{ViewData["Title"]="Administradores";}<header><h1>Usuarios administrativos</h1></header><section class="panel"><details><summary class="primary">Nuevo administrador</summary><form asp-action="Save" method="post" class="grid-form"><label>Nombre<input name="FirstName" maxlength="80" required/></label><label>Apellidos<input name="LastName" maxlength="100" required/></label><label>Correo<input name="Email" type="email" maxlength="254" required/></label><input name="IsActive" type="hidden" value="true"/><button class="primary">Crear</button></form></details><table><thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Estado</th><th>Editar</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Id</td><td>@x.FirstName @x.LastName</td><td>@x.Email</td><td>@(x.IsActive?"Activo":"Inactivo")</td><td><details><summary>Editar</summary><form asp-action="Save" method="post" class="grid-form"><input name="Id" type="hidden" value="@x.Id"/><input name="FirstName" value="@x.FirstName" required/><input name="LastName" value="@x.LastName" required/><input name="Email" type="email" value="@x.Email" required/><select name="IsActive"><option value="true" selected="@x.IsActive">Activo</option><option value="false" selected="@(!x.IsActive)">Inactivo</option></select><button>Guardar</button></form></details></td></tr>}</tbody></table></section>