@model DashboardViewModel
@{ViewData["Title"]="Resumen";}<header><h1>Resumen</h1><p>Estado general de tu tienda</p></header><section class="stats"><article><span>Clientes</span><strong>@Model.Customers</strong></article><article><span>Ventas</span><strong>@Model.Sales</strong></article><article><span>Ingresos</span><strong>@Model.Revenue.ToString("C")</strong></article><article><span>Productos</span><strong>@Model.Products</strong><small>@Model.LowStock con stock bajo</small></article></section><section class="panel"><h2>Pedidos recientes</h2><table><thead><tr><th>ID</th><th>Cliente</th><th>Fecha</th><th>Total</th><th>Estado</th></tr></thead><tbody>@foreach(var x in Model.RecentOrders){<tr><td>@x.Id</td><td>@x.CustomerEmail</td><td>@x.Date.LocalDateTime.ToString("g")</td><td>@x.Total.ToString("C")</td><td><span class="badge">@x.Status</span></td></tr>}</tbody></table></section>