@model IReadOnlyList<ReportRow>
@{ViewData["Title"]="Reportes";}<header><h1>Reporte de ventas</h1></header><section class="panel"><form method="get" class="inline-form"><label>Desde<input name="from" type="date" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"/></label><label>Hasta<input name="to" type="date" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))"/></label><label>Transacción<input name="transactionId" value="@ViewBag.Transaction" maxlength="120"/></label><button class="primary">Buscar</button></form><form asp-action="Export" method="post"><input name="from" type="hidden" value="@(((DateTime)ViewBag.From).ToString("O"))"/><input name="to" type="hidden" value="@(((DateTime)ViewBag.To).ToString("O"))"/><input name="transactionId" type="hidden" value="@ViewBag.Transaction"/><button>Exportar XLSX</button></form><table><thead><tr><th>Fecha</th><th>Cliente</th><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Total</th><th>Transacción</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Date.LocalDateTime.ToString("g")</td><td>@x.Customer</td><td>@x.Product</td><td>@x.UnitPrice.ToString("C")</td><td>@x.Quantity</td><td>@x.Total.ToString("C")</td><td>@x.TransactionId</td></tr>}</tbody></table></section>