@model OrdersViewModel
@{ViewData["Title"]="Pedidos";var f=Model.Filter;var p=Model.Orders;var pages=(int)Math.Max(1,Math.Ceiling(p.Total/(double)Math.Max(1,p.PageSize)));}<header><h1>Pedidos</h1><p>Consulta y seguimiento de órdenes</p></header><section class="panel"><form method="get" class="inline-form"><label>Estado<select name="Status"><option value="">Todos</option>@foreach(var s in OrderFilterInput.Statuses){<option value="@s.Value" selected="@(f.Status==s.Value)">@s.Label</option>}</select></label><label>Desde<input name="From" type="date" value="@f.From?.ToString("yyyy-MM-dd")"/></label><label>Hasta<input name="To" type="date" value="@f.To?.ToString("yyyy-MM-dd")"/></label><label>Transacción<input name="TransactionId" value="@f.TransactionId" maxlength="120"/></label><button class="primary">Filtrar</button><a asp-action="Index">Limpiar</a></form><table><thead><tr><th>ID</th><th>Cliente</th><th>Fecha</th><th>Productos</th><th>Total</th><th>Estado</th></tr></thead><tbody>@foreach(var x in p.Items){<tr><td><a asp-action="Details" asp-route-id="@x.Id">@x.Id</a></td><td>@x.CustomerEmail</td><td>@x.Date.LocalDateTime.ToString("g")</td><td>@x.ProductCount</td><td>@x.Total.ToString("C")</td><td><span class="badge">@x.Status</span></td></tr>}</tbody></table>@if(p.Items.Count==0){<p>Ningún pedido coincide con los filtros.</p>}<p>Página @p.Page de @pages · @p.Total pedidos @if(p.Page>1){<a asp-action="Index" asp-all-route-data="@f.Fields(p.Page-1)">← Anterior</a>} @if(p.Page<pages){<a asp-action="Index" asp-all-route-data="@f.Fields(p.Page+1)">Siguiente →</a>}</p></section>
