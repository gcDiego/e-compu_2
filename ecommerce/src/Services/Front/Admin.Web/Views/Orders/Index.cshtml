@model PagedOrders
@{ViewData["Title"]="Pedidos";}<header><h1>Pedidos</h1><p>Consulta de órdenes (sólo lectura)</p></header><section class="panel"><table><thead><tr><th>ID</th><th>Cliente</th><th>Fecha</th><th>Productos</th><th>Total</th><th>Estado</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td><a asp-action="Details" asp-route-id="@x.Id">@x.Id</a></td><td>@x.CustomerEmail</td><td>@x.Date.LocalDateTime.ToString("g")</td><td>@x.ProductCount</td><td>@x.Total.ToString("C")</td><td><span class="badge">@x.Status</span></td></tr>}</tbody></table><p>Página @Model.Page · @Model.Total pedidos</p></section>