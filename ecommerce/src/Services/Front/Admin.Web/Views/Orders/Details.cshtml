@model OrderDetailModel
@{ViewData["Title"]=$"Pedido {Model.Id}";}<header><h1>Pedido #@Model.Id</h1><p><a asp-action="Index">← Volver a pedidos</a></p></header><section class="panel"><dl class="detail-grid"><dt>Transacción</dt><dd>@Model.TransactionId</dd><dt>Estado</dt><dd><span class="badge">@Model.Status</span></dd><dt>Fecha</dt><dd>@Model.Date.LocalDateTime.ToString("g")</dd><dt>Cliente</dt><dd>@Model.CustomerName (@Model.CustomerEmail)</dd><dt>Contacto</dt><dd>@Model.Contact · @Model.Phone</dd><dt>Dirección</dt><dd>@Model.Address</dd></dl><table><thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.ProductName</td><td>@x.UnitPrice.ToString("C")</td><td>@x.Quantity</td><td>@x.Total.ToString("C")</td></tr>}</tbody></table><p><strong>Total: @Model.Total.ToString("C")</strong> · @Model.ProductCount productos</p></section>
