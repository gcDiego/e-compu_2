@model OrderDetailModel
@{ViewData["Title"]=$"Pedido {Model.Id}";}<header><h1>Pedido #@Model.Id</h1><p><a asp-action="Index">← Volver a pedidos</a></p></header><section class="panel"><dl class="detail-grid"><dt>Transacción</dt><dd>@Model.TransactionId</dd><dt>Estado</dt><dd><span class="badge">@Model.Status</span></dd>@if(!string.IsNullOrEmpty(Model.Courier)){<dt>Paquetería</dt><dd>@Model.Courier</dd>}@if(!string.IsNullOrEmpty(Model.TrackingNumber)){<dt>Número de guía</dt><dd>@Model.TrackingNumber</dd>}<dt>Fecha</dt><dd>@Model.Date.LocalDateTime.ToString("g")</dd><dt>Cliente</dt><dd>@Model.CustomerName (@Model.CustomerEmail)</dd><dt>Contacto</dt><dd>@Model.Contact · @Model.Phone</dd><dt>Dirección</dt><dd>@Model.Address</dd></dl><table><thead><tr><th>Producto</th><th>Precio</th><th>Cantidad</th><th>Total</th></tr></thead><tbody>@foreach(var x in Model.Items){<tr><td>@x.ProductName</td><td>@x.UnitPrice.ToString("C")</td><td>@x.Quantity</td><td>@x.Total.ToString("C")</td></tr>}</tbody></table><p><strong>Total: @Model.Total.ToString("C")</strong> · @Model.ProductCount productos</p></section><section class="panel"><h2>Actualizar estado y seguimiento</h2><form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post" class="grid-form"><label>Estado del pedido<select name="Status" required><option value="confirmado" selected="@(Model.Status=="confirmado")">Confirmado</option><option value="en_proceso" selected="@(Model.Status=="en_proceso")">En preparación</option><option value="enviado" selected="@(Model.Status=="enviado")">Enviado</option><option value="entregado" selected="@(Model.Status=="entregado")">Entregado</option><option value="cancelado" selected="@(Model.Status=="cancelado")">Cancelado</option></select></label><label>Paquetería<input name="Courier" value="@Model.Courier" placeholder="Ej. DHL, FedEx, Estafeta" maxlength="100"/></label><label>Número de guía / rastreo<input name="TrackingNumber" value="@Model.TrackingNumber" placeholder="Ej. GUIA12345678" maxlength="100"/></label><label>Notas para el cliente<textarea name="Comment" placeholder="Comentarios o enlace de rastreo opcional..." maxlength="250"></textarea></label><button type="submit" class="primary">Guardar y notificar al cliente</button></form></section>
