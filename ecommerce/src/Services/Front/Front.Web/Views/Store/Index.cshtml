@model CatalogViewModel
@{ ViewData["Title"] = "Catálogo"; }
<header class="hero"><h1>Equípate como un profesional</h1><p>Encuentra aquí lo último en computadoras y hardware.</p></header>
<main class="catalog-layout">
    <aside class="filters">
        <form method="get">
            <section class="panel"><h3>Categorías</h3><label><input type="radio" name="categoryId" value="" checked="@(Model.CategoryId is null)" /> Todas</label>@foreach (var item in Model.Categories){<label><input type="radio" name="categoryId" value="@item.Id" checked="@(Model.CategoryId == item.Id)" /> @item.Description</label>}</section>
            <section class="panel"><h3>Marcas</h3><label><input type="radio" name="brandId" value="" checked="@(Model.BrandId is null)" /> Todas</label>@foreach (var item in Model.Brands){<label><input type="radio" name="brandId" value="@item.Id" checked="@(Model.BrandId == item.Id)" /> @item.Description</label>}</section>
            <button class="button dark full" type="submit">Aplicar filtros</button>
        </form>
    </aside>
    <section class="products">
        @foreach (var product in Model.Products)
        {
            <article class="product-card"><div class="product-image"><img src="@(product.ImageUrl ?? Url.Content("~/images/computadora.png"))" alt="@product.Name" /></div><h3>@product.Name</h3><strong>$@product.Price.ToString("N2") MXN</strong><div class="actions"><a class="button dark" asp-action="Detail" asp-route-id="@product.Id">Ver detalles</a>@if (Context.Session.GetString("AccessToken") is not null){<form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@product.Id" /><button class="button primary full" type="submit">Agregar al carrito</button></form>}</div></article>
        }
    </section>
</main>
