@model ProductDto
@{ ViewData["Title"] = Model.Name; }
<main class="detail-wrap"><div class="breadcrumb"><a asp-action="Index">Catálogo</a> / @Model.Name</div><article class="detail"><div class="detail-image"><img src="@(Model.ImageUrl ?? Url.Content("~/images/computadora.png"))" alt="@Model.Name" /></div><div class="detail-info"><span class="brand">Marca: <b>@Model.Brand.Description</b></span><h1>@Model.Name</h1><strong class="price">$@Model.Price.ToString("N2") MXN</strong><p>@Model.Description</p><div class="actions"><a class="button danger" asp-action="Index">Volver</a>@if (Context.Session.GetString("AccessToken") is not null){<form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id" /><button class="button primary" type="submit">Agregar al carrito</button></form>}</div></div></article></main>
