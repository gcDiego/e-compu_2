@model CartSnapshotDto?
@{ ViewData["Title"] = "Carrito"; }
<main class="cart-layout"><section class="cart-panel"><div class="cart-header"><h1>Detalle del carrito</h1><a class="button dark" asp-controller="Store" asp-action="Index">Seguir comprando</a></div><div class="cart-items">@foreach (var item in Model?.Items ?? []){<article class="cart-item"><div class="cart-image"><img src="~/images/computadora.png" alt="@item.ProductName" /></div><div><span class="brand">@item.BrandName</span><h3>@item.ProductName</h3><strong>$@item.UnitPrice.ToString("N2") MXN</strong></div><div class="quantity"><form asp-action="Change" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><input type="hidden" name="increase" value="false" /><button type="submit">−</button></form><b>@item.Quantity</b><form asp-action="Change" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><input type="hidden" name="increase" value="true" /><button type="submit">+</button></form></div><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId" /><button class="button danger" type="submit">Eliminar</button></form></article>}</div><div class="total">Total: <strong>$@((Model?.Total ?? 0).ToString("N2"))</strong></div></section><aside class="shipping"><h2>Detalle de envío</h2><form asp-controller="Checkout" asp-action="Create" method="post"><label>Contacto<input type="text" name="contacto" required /></label><label>Teléfono<input type="tel" name="telefono" required /></label><label>Dirección<input type="text" name="direccion" required /></label><label>Id Localidad<input type="text" name="idLocalidad" required /></label><button class="button primary full" type="submit">Procesar pago</button></form></aside></main>
