<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - ECOMPU</title>
    <link rel="stylesheet" href="~/css/ecompu.css" asp-append-version="true" />
</head>
<body>
<nav class="nav">
    <a asp-controller="Store" asp-action="Index" class="logo"><img src="~/images/logo1.png" alt="ECOMPU" /></a>
    <div class="nav-actions">
        <a asp-controller="Store" asp-action="Index">Catálogo</a>
        @if (Context.Session.GetString("AccessToken") is null)
        {
            <a class="button primary" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
        }
        else
        {
            <a class="button outline" asp-controller="Cart" asp-action="Index">Carrito</a>
            <span class="user">@Context.Session.GetString("CustomerName")</span>
            <form asp-controller="Account" asp-action="Logout" method="post"><button class="link-button" type="submit">Salir</button></form>
        }
    </div>
</nav>
@RenderBody()
<footer> 2026 ECOMPU · Tecnología para todos</footer>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
