@model RegisterViewModel
@{ Layout = null; ViewData["Title"] = "Crear cuenta"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Crear cuenta - ECOMPU</title><link rel="stylesheet" href="~/css/site.css" /><link rel="stylesheet" href="~/css/ecompu.css" /></head><body class="auth-body"><main class="auth-card"><a asp-controller="Store" asp-action="Index"><img src="~/images/logo1.png" alt="ECOMPU" /></a><h1>Crear cuenta</h1><form method="post"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><label>Nombre<input type="text" name="firstName" value="@Model.FirstName" required autocomplete="given-name" /></label><label>Apellidos<input type="text" name="lastName" value="@Model.LastName" required autocomplete="family-name" /></label><label>Correo electrónico<input type="email" name="email" value="@Model.Email" required autocomplete="email" /></label><label>Contraseña<input type="password" name="password" required autocomplete="new-password" /></label>@if (Model.Error is not null){<div class="alert">@Model.Error</div>}<button class="button primary full" type="submit">Registrarse</button></form><a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">¿Ya tienes cuenta? Inicia sesión</a></main></body></html>
