@model ResetViewModel
@{ Layout = null; ViewData["Title"] = "Restablecer contraseña"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Restablecer contraseña - ECOMPU</title><link rel="stylesheet" href="~/css/site.css" /><link rel="stylesheet" href="~/css/ecompu.css" /></head><body class="auth-body"><main class="auth-card"><a asp-controller="Store" asp-action="Index"><img src="~/images/logo1.png" alt="ECOMPU" /></a><h1>Restablecer contraseña</h1><p>Ingresa el token y tu nueva contraseña</p><form method="post" asp-action="Reset"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><label>Correo electrónico<input type="email" name="email" value="@Model.Email" required autocomplete="email" /></label><label>Token<input type="text" name="token" value="@Model.Token" required /></label><label>Nueva contraseña<input type="password" name="newPassword" required minlength="12" /></label><label>Confirmar contraseña<input type="password" name="confirmPassword" required minlength="12" /></label>@if (Model.Error is not null){<div class="alert">@Model.Error</div>}<button class="button primary full" type="submit">Restablecer</button></form><p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Volver al inicio de sesión</a></p></main></body></html>
