@model LoginViewModel
@{ Layout = null; ViewData["Title"] = "Recuperar contraseña"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Recuperar contraseña - ECOMPU</title><link rel="stylesheet" href="~/css/site.css" /><link rel="stylesheet" href="~/css/ecompu.css" /></head><body class="auth-body"><main class="auth-card"><a asp-controller="Store" asp-action="Index"><img src="~/images/logo1.png" alt="ECOMPU" /></a><h1>Recuperar contraseña</h1><p>Ingresa tu correo para recibir un token</p><form method="post" asp-action="Recover"><input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" /><label>Correo electrónico<input type="email" name="email" value="@Model.Email" required autocomplete="email" /></label>@if (Model.Error is not null){<div class="alert">@Model.Error</div>}<button class="button primary full" type="submit">Enviar token</button></form><p><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">Volver al inicio de sesión</a></p></main></body></html>
