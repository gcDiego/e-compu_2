@model Front.Web.Models.ProfileViewModel
@{ ViewData["Title"] = "Mi perfil"; }
<main class="cart-layout">
    <section class="cart-panel">
        <div class="cart-header">
            <h1>Mi perfil</h1>
            <a class="button dark" asp-controller="Store" asp-action="Index">Seguir comprando</a>
        </div>
        @if (ViewData["Success"] is string success)
        {
            <div class="alert success">@success</div>
        }
        @if (Model.Error is not null)
        {
            <div class="alert">@Model.Error</div>
        }
        <form method="post" asp-action="Index">
            <label>Correo electrónico<input type="email" value="@Model.Email" disabled /></label>
            <label>Nombre(s)<input type="text" name="FirstName" value="@Model.FirstName" required minlength="1" maxlength="80" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ ]+" title="Solo se permiten letras y espacios" data-name-field /></label>
            <label>Apellido(s)<input type="text" name="LastName" value="@Model.LastName" required minlength="1" maxlength="100" pattern="[A-Za-zÁÉÍÓÚÜÑáéíóúüñ ]+" title="Solo se permiten letras y espacios" data-name-field /></label>
            <button class="button primary" type="submit">Guardar cambios</button>
        </form>
        <p><a asp-controller="Profile" asp-action="ChangePassword">Cambiar contraseña</a></p>
    </section>
</main>
